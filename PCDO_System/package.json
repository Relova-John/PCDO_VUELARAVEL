{
    "name": "pcdo-system",
    "version": "1.0.0",
    "author": "Relova, Chiong, Francisco",
    "description": "This is a PCDO Desktop Application.",
    "private": true,
    "main": "electron/main.cjs",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "electron": "electron .",
        "electron:build": "electron-builder",
        "electron:build:win": "electron-builder --windows"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/eslint-config-typescript": "^14.3.0",
        "concurrently": "^9.2.1",
        "cross-env": "^10.1.0",
        "electron": "^38.3.0",
        "electron-builder": "^26.0.12",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-vue": "^9.32.0",
        "prettier": "^3.4.2",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^7.0.4",
        "vue-tsc": "^2.2.4"
    },
    "dependencies": {
        "@inertiajs/vue3": "^2.2.5",
        "@vueuse/core": "^12.8.2",
        "apexcharts": "^5.3.5",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.18",
        "laravel-vite-plugin": "^2.0.0",
        "lucide-vue-next": "^0.468.0",
        "pdfjs-dist": "^5.4.296",
        "reka-ui": "^2.8.0",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.13",
        "vue-sonner": "^2.0.9",
        "vue3-apexcharts": "^1.8.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "build": {
        "appId": "com.pcdo.desktop",
        "productName": "PCDO Desktop",
        "directories": {
            "output": "dist"
        },
        "files": [
            "electron/",
            "public/",
            "resources/",
            "bootstrap/",
            "app/",
            "routes/",
            "config/",
            "database/",
            ".env",
            "artisan",
            "vendor/"
        ],
        "asar": true,
        "asarUnpack": [
            ".env",
            "bootstrap/**",
            "config/**",
            "app/**",
            "routes/**",
            "database/**",
            "storage/**"
        ],
        "extraResources": [
            {
                "from": "electron/resources/php/",
                "to": "php/"
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "ia32"
                    ]
                }
            ],
            "icon": "resources/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "perMachine": true,
            "allowElevation": true,
            "shortcutName": "PCDOapp",
            "deleteAppDataOnUninstall": true,
            "installerIcon": "",
            "uninstallerIcon": "",
            "displayLanguageSelector": false
        }
    }
}
